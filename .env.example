# ============================================================
# 업비트 자동매매 봇 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# ---- 업비트 API 키 ----
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ---- 거래 대상 마켓 ----
UPBIT_MARKET=KRW-BTC
# 여러 마켓 동시 운용 (콤마 구분, 비워두면 UPBIT_MARKET만 사용)
# 예: UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP

# ---- 봇 설정 ----
# 분봉 단위. 백테스트/검증/실거래가 모두 이 값을 씁니다 (업비트 지원: 1,3,5,10,15,30,60,240)
BOT_CANDLE_UNIT=15
BOT_INTERVAL_SECONDS=10
BOT_DRY_RUN=true
BOT_LOG_LEVEL=INFO
BOT_LOG_SIGNAL_CHANGE_ONLY=true
BOT_DRY_RUN_INITIAL_KRW=1000000

# ---- GPT 리뷰 에이전트 (선택) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=20

# ---- LLM 매수 게이트 (선택) ----
LLM_GATE_ENABLED=false
LLM_GATE_MODEL="gpt-4o-mini"
LLM_GATE_TIMEOUT_SECONDS=8
LLM_GATE_MIN_CONFIDENCE=0.55
LLM_GATE_FAIL_OPEN=true
LLM_GATE_MAX_INPUT_CANDLES=120
# 신호 변경 시점에만 AI 분석 결과를 갱신합니다. (코드 기본 동작)

# ---- AI 자율 매매 전략 (선택) ----
AI_TRADER_ENABLED=true
AI_TRADER_MODEL="gpt-4o-mini"
AI_TRADER_TIMEOUT_SECONDS=10
AI_TRADER_MAX_INPUT_CANDLES=160
AI_TRADER_MIN_CONFIDENCE=0.55
AI_TRADER_FAIL_SIGNAL=HOLD

# ---- 백테스트 설정 ----
# FEE_RATE/SLIPPAGE_RATE 는 백테스트뿐 아니라 DRY_RUN 모의체결에도 적용됩니다.
INITIAL_CAPITAL=1000000
FEE_RATE=0.0005                 # 업비트 KRW 마켓 0.05%
SLIPPAGE_RATE=0.0005

# ---- 리스크 관리 ----
# 아래 값은 bot/config.py 의 기본값과 동일합니다. .env 가 없으면 이 값들이 적용됩니다.
BUY_RATIO_PCT=0.30              # 잔고 대비 1회 매수 비율
MIN_KRW_RESERVE=5000            # 최소 유지 KRW
STOP_LOSS_PCT=0.03              # 손절 -3%
TAKE_PROFIT_PCT=0.0             # 고정 익절 (0 = 비활성)
TRAILING_STOP_PCT=0.02          # 고점 대비 -2% 트레일링
MIN_NET_PROFIT_PCT=0.25         # 추세매도 최소 순이익 기준(%). 손절폭과 함께 손익비를 결정한다.
                                # 경고: 이 값이 크면 손실 구간에서 추세매도가 막혀
                                #       손절(-STOP_LOSS_PCT)까지 포지션을 끌고 간다.
MAX_CHASE_PCT=0.004             # 신호봉 종가 대비 최대 추격매수 허용폭
MAX_POSITIONS=1                 # 최대 동시 포지션 수 (0 = 무제한)
COOLDOWN_SECONDS=300            # 주문 후 재진입 대기
MAX_CONSECUTIVE_BUY_SIGNALS=2   # 연속 BUY 허용 횟수 (0 = 비활성)
ATR_REDUCE_MULT=2.0
ATR_BLOCK_MULT=2.8
HIGH_VOL_BUY_SCALE=0.5
