# ============================================================
# 업비트 자동매매 봇 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# ---- 업비트 API 키 ----
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ---- 거래 대상 마켓 ----
UPBIT_MARKET=KRW-BTC
# 여러 마켓 동시 운용 (콤마 구분, 비워두면 UPBIT_MARKET만 사용)
# 예: UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
UPBIT_MARKETS=

# ---- 봇 설정 ----
BOT_INTERVAL_SECONDS=10
BOT_DRY_RUN=true
BOT_LOG_LEVEL=INFO

# ---- 백테스트 설정 ----
INITIAL_CAPITAL=1000000
FEE_RATE=0.0005
SLIPPAGE_RATE=0.0005

# ---- 리스크 관리 ----
BUY_RATIO_PCT=0.30
MIN_KRW_RESERVE=5000
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.02
MIN_NET_PROFIT_PCT=0.00
MAX_CHASE_PCT=0.004
MAX_POSITIONS=0
COOLDOWN_SECONDS=300
