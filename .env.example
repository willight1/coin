# ============================================================
# 업비트 자동매매 봇 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# ---- 업비트 API 키 ----
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ---- 거래 대상 마켓 ----
UPBIT_MARKET=KRW-BTC
# 여러 마켓 동시 운용 (콤마 구분, 비워두면 UPBIT_MARKET만 사용)
# 예: UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP

# ---- 봇 설정 ----
BOT_INTERVAL_SECONDS=10
BOT_DRY_RUN=true
BOT_LOG_LEVEL=INFO
BOT_LOG_SIGNAL_CHANGE_ONLY=true
BOT_DRY_RUN_INITIAL_KRW=1000000

# ---- GPT 리뷰 에이전트 (선택) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=20

# ---- LLM 매수 게이트 (선택) ----
LLM_GATE_ENABLED=false
LLM_GATE_MODEL="gpt-4o-mini"
LLM_GATE_TIMEOUT_SECONDS=8
LLM_GATE_MIN_CONFIDENCE=0.55
LLM_GATE_FAIL_OPEN=true
LLM_GATE_MAX_INPUT_CANDLES=120
# 신호 변경 시점에만 AI 분석 결과를 갱신합니다. (코드 기본 동작)

# ---- 백테스트 설정 ----
INITIAL_CAPITAL=1000000
FEE_RATE=0.0005
SLIPPAGE_RATE=0.0005

# ---- 리스크 관리 ----
BUY_RATIO_PCT=0.30
MIN_KRW_RESERVE=5000
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
TRAILING_STOP_PCT=0.02
MIN_NET_PROFIT_PCT=0.00
MAX_CHASE_PCT=0.004
MAX_POSITIONS=0
COOLDOWN_SECONDS=60
MAX_CONSECUTIVE_BUY_SIGNALS=0
ATR_REDUCE_MULT=2.0
ATR_BLOCK_MULT=2.8
HIGH_VOL_BUY_SCALE=0.5
