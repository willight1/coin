# ============================================================
# 업비트 자동매매 봇 환경변수 설정
# 이 파일을 .env로 복사한 후 실제 값을 입력하세요.
# cp .env.example .env
# ============================================================

# ---- 업비트 API 키 ----
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# ---- 거래 대상 마켓 ----
UPBIT_MARKET=KRW-BTC
# 여러 마켓 동시 운용 (콤마 구분, 비워두면 UPBIT_MARKET만 사용)
# 예: UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP
UPBIT_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP

# ---- 봇 설정 ----
# 분봉 단위. 백테스트/검증/실거래가 모두 이 값을 씁니다 (업비트 지원: 1,3,5,10,15,30,60,240 / 1440=일봉)
# 기본 전략(일봉 SMA50 추세)은 1440 에서만 실거래가 시작된다 (CLAUDE.md 참고)
BOT_CANDLE_UNIT=1440
BOT_INTERVAL_SECONDS=10
BOT_DRY_RUN=true
BOT_LOG_LEVEL=INFO
BOT_LOG_SIGNAL_CHANGE_ONLY=true
BOT_DRY_RUN_INITIAL_KRW=1000000
# DRY_RUN 가상 잔고는 state/dry_run_<마켓>.json 에 저장돼 재시작해도 이어집니다.
# 처음부터 다시 하려면(초기 금액 변경 포함) 그 파일을 지우세요.

# ---- 텔레그램 알림 (선택, 비우면 알림 없음) ----
# 시작/종료, 매수·매도 체결, 하루 1회 상태(안 오면 봇이 죽은 것), 모든 ERROR 로그(같은 에러는 10분에 1번)
# 봇에게 /status, /market, /help 를 보내면 답한다 (조회 전용, 등록된 CHAT_ID 에만)
# 1) 텔레그램 @BotFather 에서 /newbot -> 토큰 발급
# 2) 만든 봇에게 아무 메시지나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 "chat":{"id": ...} 확인
# 3) 확인: ./venv/bin/python -c "from bot import notifier; print(notifier.notify('테스트'))"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---- VWAP 회귀 가상거래 (--mode vwap-paper, 실제 주문 없음) ----
# 세션(09:00) VWAP 보다 VWAP_ENTRY_PCT 만큼 아래로 내려가면 지정가 매수, VWAP 위로 오르면 VWAP 에 지정가 매도, 09:00 강제 청산
# 실행: BOT_LOG_PREFIX=vwap ./venv/bin/python main.py --mode vwap-paper   (로그: logs/vwap_<날짜>.log, 체결: logs/vwap_paper_trades.csv)
VWAP_MARKETS=KRW-BTC,KRW-ETH
VWAP_PAPER_KRW=1000000
VWAP_ENTRY_PCT=0.01

# ---- GPT 리뷰 에이전트 (선택) ----
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TIMEOUT_SECONDS=20

# ---- LLM 매수 게이트 (선택) ----
LLM_GATE_ENABLED=false
LLM_GATE_MODEL="gpt-4o-mini"
LLM_GATE_TIMEOUT_SECONDS=8
LLM_GATE_MIN_CONFIDENCE=0.55
LLM_GATE_FAIL_OPEN=true
LLM_GATE_MAX_INPUT_CANDLES=120
# 신호 변경 시점에만 AI 분석 결과를 갱신합니다. (코드 기본 동작)

# ---- AI 자율 매매 전략 (선택) ----
AI_TRADER_ENABLED=true
AI_TRADER_MODEL="gpt-4o-mini"
AI_TRADER_TIMEOUT_SECONDS=10
AI_TRADER_MAX_INPUT_CANDLES=160
AI_TRADER_MIN_CONFIDENCE=0.55
AI_TRADER_FAIL_SIGNAL=HOLD

# ---- 백테스트 설정 ----
# FEE_RATE/SLIPPAGE_RATE 는 백테스트뿐 아니라 DRY_RUN 모의체결에도 적용됩니다.
INITIAL_CAPITAL=1000000
FEE_RATE=0.0005                 # 업비트 KRW 마켓 0.05%
SLIPPAGE_RATE=0.0005

# ---- 리스크 관리 ----
# 아래 값은 bot/config.py 의 기본값과 동일합니다. .env 가 없으면 이 값들이 적용됩니다.
BUY_RATIO_PCT=0.30              # 잔고 대비 1회 매수 비율
# 일봉 SMA 추세 전략 전용 매수 비율 (위 BUY_RATIO_PCT 를 쓰지 않음)
#   1.0 = 측정 기준, 과거 MDD 56% / 0.5 = MDD 40%, 연수익 약 +48%
TREND_BUY_RATIO_PCT=1.0
# 장중 경고: 현재가가 기준선(오늘 종가가 깨면/넘으면 신호가 바뀌는 가격)까지 이 비율 이내면 텔레그램 경고
TREND_WARN_PCT=0.03
MIN_KRW_RESERVE=5000            # 최소 유지 KRW
STOP_LOSS_PCT=0.03              # 손절 -3%
TAKE_PROFIT_PCT=0.0             # 고정 익절 (0 = 비활성)
TRAILING_STOP_PCT=0.02          # 고점 대비 -2% 트레일링
MIN_NET_PROFIT_PCT=0.25         # 추세매도 최소 순이익 기준(%). 손절폭과 함께 손익비를 결정한다.
                                # 경고: 이 값이 크면 손실 구간에서 추세매도가 막혀
                                #       손절(-STOP_LOSS_PCT)까지 포지션을 끌고 간다.
MAX_CHASE_PCT=0.004             # 신호봉 종가 대비 최대 추격매수 허용폭
MAX_POSITIONS=1                 # 최대 동시 포지션 수 (0 = 무제한)
COOLDOWN_SECONDS=300            # 주문 후 재진입 대기
MAX_CONSECUTIVE_BUY_SIGNALS=2   # 연속 BUY 허용 횟수 (0 = 비활성)
ATR_REDUCE_MULT=2.0
ATR_BLOCK_MULT=2.8
HIGH_VOL_BUY_SCALE=0.5

# ---- BTC 자율 에이전트 (--mode btc-agent, docs/BTC_DAYTRADE.md) ----
# 50일선 봇(--mode trade)과 같은 계좌를 쓴다. 에이전트 몫(현금·BTC)은 state/dt_live.json 에 기록되고
# 50일선 봇은 그 몫을 빼고 매매한다. 아래 한도는 코드가 강제하며 LLM 이 바꿀 수 없다.
DT_BUDGET_KRW=                  # 필수. 운용 금액. 코인 봇(--market)이 여러 개면 이 돈 하나를 같이 쓰고 손실 한도도 합쳐서 본다
DT_LIVE_CONFIRM=                # yes 여야 실제 주문 (비우면 호가 기준 가상 체결)
# LLM 경로 (docs/BTC_DAYTRADE_LLM_CACHE.md)
#   경로 1 claude_cli: 이 맥에서 Max 구독으로 로그인한 claude -p (구독 사용 한도에서 차감).
#     봇이 claude 를 부를 때 ANTHROPIC_API_KEY 를 환경에서 지운다 — 남아 있으면 구독 대신 API 키로 과금된다
#   경로 2 api: ANTHROPIC_API_KEY 로 Messages API + 시스템 프롬프트 1시간 캐싱.
#     경로 1 이 rate_limit/인증/결제/과부하 오류를 내거나, 시간 초과·형식 오류가 2회 연속이면 넘어간다
DT_LLM_PRIMARY=claude_cli       # claude_cli | api (api 면 DT_API_TOTAL_BUDGET_USD 다 쓰고 구독으로)
DT_LLM_FALLBACK=api             # 주 경로 실패 시 반대쪽으로 | none
DT_QUICK_MODEL=claude-haiku-5-5    # 빠른 점검: 플랜 유지(keep)인지 다시 판단(escalate)인지만. 주문 못 함
DT_DEEP_MODEL=claude-sonnet-5-5    # 깊은 판단: 국면·전략·파라미터·매매
DT_CLI_WORKDIR=~/orca/dt_llm_empty   # 빈 전용 폴더 (저장소에서 돌리면 CLAUDE.md·스킬·훅을 읽는다)
DT_CLI_TIMEOUT_SEC=120
DT_FALLBACK_HOLD_MIN=60         # 경로 2로 넘어간 뒤 경로 1 재시도까지
DT_CHECK_HOT_MIN=1              # 빠른 점검 간격: 신호 임박(진입가 0.3% 이내, 1h RSI 65~70 상승)·발생 후 30분
DT_CHECK_HOLDING_MIN=2          #   보유 중
DT_CHECK_IDLE_MIN=5             #   현금이고 조용함
DT_MAX_QUICK_CALLS_PER_DAY=800
DT_MAX_DEEP_CALLS_PER_DAY=120   # 넘으면 현재 플랜만 실행 (보유 중 urgent_sell 은 예외)
DT_API_DAILY_BUDGET_USD=3       # 경로 2(API) 하루 비용. 넘으면 빠른 점검 간격 2배
DT_API_TOTAL_BUDGET_USD=0       # API 누적 비용 상한(달러). 닿으면 구독으로. 0 = 상한 없음
DT_API_RESET_DAY=0              # 매달 이 날 0시에 누적 비용을 0 으로 (월간 크레딧 충전일, 1~28). 0 = 안 지움
# ANTHROPIC_API_KEY=            # 경로 2 키. .env 에 직접 넣는다 (채팅·로그에 붙여 넣지 않기)
# ANTHROPIC_WORKSPACE_ID=       # 워크스페이스에 안 묶인 조직 키면 필요 (wrkspc_...). 콘솔 Settings > Workspaces
DT_MAX_BUYS_PER_DAY=6           # 거래일 = 09:00 KST 시작. 0 = 제한 없음
DT_DAILY_LOSS_PCT=3             # 예산 대비 당일 손실(실현+미실현) → 그날 신규 매수 중지
DT_WEEKLY_LOSS_PCT=8            # 7일 손실 → 신규 매수 중지, /dt_go 전까지
DT_KILL_DRAWDOWN_PCT=15         # 시작 예산 대비 평가금액 하락 → 전량 매도 후 정지
DT_STOP_MIN_PCT=1.5
DT_STOP_MAX_PCT=5.0
DT_MAX_HOLD_HOURS=96            # sma_trend_daily 제외
DT_COOLDOWN_MIN=30
DT_MAX_SPREAD_BP=5
DT_MIN_CONFIDENCE=0.6
DT_DISCRETIONARY_MAX_PCT=30
DT_MIN_PLAN_HOLD_MIN=60
DT_WAKE_MOVE_PCT=1.0
DT_ADOPT_ACCOUNT_BTC=false      # true 면 봇 기록 없는 계좌 BTC 를 넘겨받는다 (50일선 봇 물량 주의)

# ---- 하이퍼리퀴드 롱·숏 추세 봇 (--mode hl-agent, bot/hl_live.py) ----
# 8개 지표 투표(일봉 이평50·이평50+ADX·RSI추세·이평100, 4h 이평200·정배열·RSI추세·모멘텀90) + 변동성 맞춤 레버리지.
# 측정(바이낸스 2017~2026, 목표변동성 60%·상한 3배): BTC 연 +59% MDD 47%, ETH +56% MDD 44%. 고정 2~3배는 전멸 (strategy-research 스킬)
HL_BUDGET_USD=1000              # 가상 모드 시작 자산(달러). 실거래는 계좌 평가금액을 쓴다
HL_COINS=BTC,ETH                # 자산을 코인 수로 똑같이 나눠 각각 운용. 리플 같은 급등 코인은 숏이 위험해 넣지 않음
HL_TARGET_VOL=0.60              # 목표 연변동성. 배수 = 이 값 ÷ 최근 20일 실현변동성. 0.80 이면 수익·MDD 둘 다 커짐
HL_MAX_LEV=3                    # 배수 상한. 측정상 3→10 으로 올려도 결과 같음 (코인은 그만큼 조용한 때가 없다). 거래소 상한(BTC 40·ETH 25) 안에서 잘림
HL_MIN_LEV=0                    # 배수 하한. 0 = 없음(권장). 2 면 과거 MDD 47% → 89%, 3 이면 98%, 5 이상은 전멸
HL_KILL_DRAWDOWN_PCT=60         # 시작 자산 대비 평가금액 하락 → 전량 청산 후 정지 (state/HL_STOP). 0 = 끔
HL_MAKER_WAIT_SEC=300           # 지정가 우선: 재조정 주문을 지정가(post-only)로 걸고 이 시간(초) 뒤 남은 건 시장가. 0 = 바로 시장가
# 1 = 시장가를 쓰지 않는다(지정가로만, 못 채운 정리 수량은 30초마다 다시 건다). 킬 드로다운 청산만 시장가. 0 = 지정가 뒤 남은 건 시장가
HL_MAKER_ONLY=1
HL_AI_SHADOW=1                  # AI 운용역 그림자 기록(매매에 안 씀, 하루 약 $0.1, ANTHROPIC_API_KEY 필요). 0 = 끔
HL_LIVE_CONFIRM=                # yes + 아래 키가 있어야 실제 주문. 비우면 중간가 가상 체결
# HL_PRIVATE_KEY=               # 하이퍼리퀴드 "API 지갑" 개인키 (매매만 가능, 출금 불가). .env 에 직접 넣는다
# HL_WALLET_ADDRESS=            # API 지갑을 쓰면 본 지갑(돈 있는 지갑) 주소
